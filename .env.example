# ============================================================
# InstaScrape Configuration
# Salin file ini menjadi '.env' dan isi data Anda:
#   cp .env.example .env
# ============================================================

# [PILIHAN 1 - SANGAT DIREKOMENDASIKAN]
# Masukkan sessionid dari browser (Buka instagram.com -> F12 -> Application -> Cookies -> sessionid)
IG_SESSIONID=

# Atau Anda bisa menempelkan seluruh header Cookie di sini:
IG_COOKIE=

# [PILIHAN 2 - Kredensial Username & Password]
# Jika ingin mencoba login otomatis via akun:
IG_USERNAME=
IG_PASSWORD=

# [PENGATURAN SCRAPING]
# Batas request per detik (disarankan 0.5 sampai 2.0 agar tidak terkena rate limit 429)
DEFAULT_RPS=1.0

# Ambil juga balasan komentar (replies)? (True/False)
INCLUDE_REPLIES=True
